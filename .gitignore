# Rust build artifacts
/target
**/*.rs.bk

# Corpus / index state. The pinned manifest.json IS committed (it is the
# reproducibility pin); the downloaded html files are regenerable state.
/corpus/*.html
/index.sqlite3
/index/

# Eval results: derived state; the eval set itself (eval/evalset.json) IS
# committed — it is the reproducibility pin for retrieval scores.
/eval/results/

# Minigraf temporal memory (machine session state; the graph + FTS index are
# regenerable — see the temporal-reasoning skill used in tlarc).
/memory.graph
/memory.graph.fts.sqlite3

# Temporal-reasoning skill wiring (.mcp.json + .claude carry machine-specific
# paths, same convention as tlarc).
/.mcp.json
/.claude/

# Local tooling state
/.codewhale/

# IDE
/.idea
/.vscode
*.iml

# OS
.DS_Store
